                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Aranzmani"
                ],
                "summary": "Izmena aranzmana",
                "description": "Menja podatke postojeceg aranzmana. Dostupno samo administratorima i menadzeru.",
                "operationId": "32224ab0d6d63647549d20ecfb7ad8fe",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Novo ime aranzmana"
                                    },
                                    "price": {
                                        "type": "number",
                                        "example": 599.99
                                    },
                                    "discount_percent": {
                                        "type": "integer",
                                        "example": 15
                                    },
                                    "is_last_minute": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Aranzman uspesno izmenjen"
                    },
                    "404": {
                        "description": "Aranzman nije pronadjen"
                    },
                    "422": {
                        "description": "Greska validacije"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Aranzmani"
                ],
                "summary": "Brisanje aranzmana",
                "description": "Brise aranzman na osnovu ID-a. Dostupno samo administratorima.",
                "operationId": "75b454a1ccbc48c7b59e345433dca03b",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Aranzman uspesno obrisan"
                    },
                    "404": {
                        "description": "Aranzman nije pronadjen"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
