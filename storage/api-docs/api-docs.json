                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "marko@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "lozinka123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
