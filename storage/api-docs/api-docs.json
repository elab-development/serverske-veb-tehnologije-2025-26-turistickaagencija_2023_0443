    "paths": {
        "/api/arrangements": {
            "get": {
                "tags": [
                    "Aranzmani"
                ],
                "summary": "Lista svih aranzmana",
                "description": "Vraca paginiranu listu aranzmana sa opcionalnim filterima i sortiranjem.",
                "operationId": "07211e7786b083cde77c8e80cc2594b8",
                "parameters": [
                    {
                        "name": "destination",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "Greece"
                    },
                    {
                        "name": "last_minute",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "enum": [
                                0,
                                1
                            ]
                        },
                        "example": 1
                    },
                    {
                        "name": "min_price",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "number"
                        },
                        "example": 100
                    },
                    {
                        "name": "max_price",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "number"
                        },
                        "example": 1000
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "price_asc",
                                "price_desc",
                                "duration_asc",
                                "duration_desc"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Uspesno vracena lista aranzmana"
                    },
                    "401": {
                        "description": "Neautorizovan pristup"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Aranzmani"
                ],
                "summary": "Kreiranje novog aranzmana",
                "description": "Kreira novi turisticki aranzman. Dostupno samo administratorima i menadzeru.",
                "operationId": "bef7f98f1d13c3210e98bc5bf60d32ee",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "title",
                                    "destination",
                                    "price",
                                    "duration_days"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Letovanje u Grckoj"
                                    },
                                    "destination": {
                                        "type": "string",
                                        "example": "Greece"
                                    },
                                    "price": {
                                        "type": "number",
                                        "example": 499.99
                                    },
                                    "duration_days": {
                                        "type": "integer",
                                        "example": 7
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Predivno letovanje"
                                    },
                                    "discount_percent": {
                                        "type": "integer",
                                        "example": 10
                                    },
                                    "is_last_minute": {
                                        "type": "integer",
                                        "example": 0,
                                        "enum": [
                                            0,
                                            1
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Aranzman uspesno kreiran"
                    },
                    "422": {
                        "description": "Greska validacije"
                    },
                    "401": {
                        "description": "Neautorizovan pristup"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/arrangements/{id}": {
            "get": {
                "tags": [
